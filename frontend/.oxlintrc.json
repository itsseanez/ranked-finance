{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["dist", "src/lib/api-schema.d.ts"],
  "overrides": [
    {
      "files": ["src/lib/**", "src/components/**", "src/styles/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features", "@/features/**", "@/app", "@/app/**"],
                "message": "Shared code (lib, components, styles) never imports features or the app shell."
              },
              {
                "regex": "^\\.\\./(\\.\\./|[^./][^/]*/)",
                "message": "Import other folders with @/ (for example @/lib/api-client)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/auth/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/**",
                  "!@/features/auth",
                  "!@/features/auth/**"
                ],
                "message": "A feature never imports another feature. Move shared code to @/components or @/lib."
              },
              {
                "group": ["@/app", "@/app/**"],
                "message": "Features don't import the app shell."
              },
              {
                "regex": "^\\.\\./(\\.\\./|[^./][^/]*/)",
                "message": "Import other folders with @/ (for example @/lib/api-client)."
              }
            ]
          }
        ]
      }
    },
